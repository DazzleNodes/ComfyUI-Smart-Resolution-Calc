#!/bin/bash
#
# Post-commit hook (repokit-common)
# Updates _version.py with the actual commit hash after commit is created
#

# Shared code (finding the vendored copy and the version tools) lives in lib.sh
# beside this hook.
_rk_lib="$(dirname "$0")/lib.sh"
if [ ! -f "$_rk_lib" ]; then
    echo "repokit-common: $(basename "$0") cannot run -- lib.sh is not beside it in $(dirname "$0")." >&2
    echo "  Re-run install-hooks.sh from the vendored repokit-common copy." >&2
    exit 1
fi
. "$_rk_lib"
rk_locate
rk_read_settings output || true   # only the output style; a broken file is reported by pre-commit
rk_setup_output

# Refresh the version string with the new commit's hash. A failure is reported
# with the tool's own words: the commit already exists, so this cannot block,
# but it must never claim an update that did not happen.
if [ -n "$SYNC_SCRIPT" ] && command -v python >/dev/null 2>&1; then
    _rk_out="$(python "$SYNC_SCRIPT" 2>&1)"
    _rk_rc=$?
elif [ -n "$UPDATE_SCRIPT" ]; then
    _rk_out="$("$UPDATE_SCRIPT" 2>&1)"
    _rk_rc=$?
else
    exit 0
fi
if [ $_rk_rc -eq 0 ]; then
    echo "${RK_OK} Version updated with commit hash $(git rev-parse --short HEAD)"
else
    echo "${RK_WARN} Warning: version hash not updated for $(git rev-parse --short HEAD):"
    printf '%s\n' "$_rk_out" | sed 's/^/    /'
fi

exit 0